              "build",
              "burned_seed",
              "v75_policy",
              "v75_gate"
            ],
            "if": "${{ needs.v75_gate.outputs.pass == 'true' }}",
            "runs-on": "ubuntu-24.04",
            "strategy": {
              "fail-fast": false,
              "matrix": {
                "window": [
                  "Y2021",
                  "Y2022",
                  "Y2023"
                ]
              }
            },
            "timeout-minutes": 50
          },
          "v76_gate": {
            "needs": "v76_slot",
            "runs-on": "ubuntu-24.04"
          },
          "promote_v76": {
            "needs": "v76_gate",

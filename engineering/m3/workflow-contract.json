          },
          "v77_capacity": {
            "needs": [
              "build",
              "burned_seed",
              "v75_policy",
              "v76_gate"
            ],
            "if": "${{ needs.v76_gate.outputs.pass == 'true' }}",
            "runs-on": "ubuntu-24.04",
            "strategy": {
              "fail-fast": false,
              "max-parallel": 6,
              "matrix": {
                "mode": [
                  "SINGLE",
                  "GRID"
                ],
                "risk": [
                  1,
                  2,
                  3,
                  5
                ],
                "window": [
                  "Y2021",
                  "Y2022",
                  "Y2023"
                ]
              }
            },
            "timeout-minutes": 55
          },
          "v77_gate": {
            "needs": "v77_capacity",
            "runs-on": "ubuntu-24.04"
          },
          "promote_v77": {
            "needs": "v77_gate",
            "if": "${{ needs.v77_gate.outputs.pass == 'true' }}",
            "runs-on": "ubuntu-24.04"
          },
          "embedded_build": {
            "needs": [
              "v74_tournament",
              "v77_gate"
            ],
            "if": "${{ needs.v77_gate.outputs.pass == 'true' }}",
            "runs-on": "ubuntu-24.04",
            "timeout-minutes": 30
          },
          "dev_seed": {
            "needs": [
              "build",
              "v77_gate"
            ],
            "if": "${{ needs.v77_gate.outputs.pass == 'true' }}",
            "runs-on": "ubuntu-24.04",
            "strategy": {
              "fail-fast": false,
              "matrix": {
                "window": [
                  "H2024H2",
                  "H2025H1",
                  "H2025H2"
                ]
              }
            },
            "timeout-minutes": 50
          },
          "dev_candidate": {
            "needs": [
              "embedded_build",
              "dev_seed",
              "v77_gate"
            ],
            "runs-on": "ubuntu-24.04",
            "strategy": {
              "fail-fast": false,
              "matrix": {
                "window": [
                  "H2024H2",
                  "H2025H1",
                  "H2025H2"
                ]
              }
            },
            "timeout-minutes": 50
          },
          "dev_gate": {
            "needs": "dev_candidate",
            "runs-on": "ubuntu-24.04"
          },
          "promote_v78": {
            "needs": "dev_gate",
            "if": "${{ needs.dev_gate.outputs.pass == 'true' }}",
            "runs-on": "ubuntu-24.04"
          },
          "validation_seed": {
            "needs": [
              "build",
              "dev_gate"
            ],
            "if": "${{ needs.dev_gate.outputs.pass == 'true' }}",
            "runs-on": "ubuntu-24.04",
            "strategy": {
              "matrix": {
                "window": [
                  "Q12026",
                  "Q22026"
                ]
              }
            },
            "timeout-minutes": 50
          },
          "validation_candidate": {
            "needs": [
              "embedded_build",
              "validation_seed",
              "dev_gate"
            ],
            "runs-on": "ubuntu-24.04",
            "strategy": {
              "matrix": {
                "window": [
                  "Q12026",
                  "Q22026"
                ]
              }
            },
            "timeout-minutes": 50
          },
          "validation_gate": {
            "needs": "validation_candidate",
            "runs-on": "ubuntu-24.04"
          },
          "fresh_seed": {
            "needs": [
              "build",
              "validation_gate"
            ],
            "if": "${{ needs.validation_gate.outputs.pass == 'true' }}",
            "runs-on": "ubuntu-24.04",
            "timeout-minutes": 50
          },
          "fresh_candidate": {

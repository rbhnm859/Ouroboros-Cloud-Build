  "scope": "Evidence-backed R17/R18 shared-account exclusion and unrelated workflow isolation; see FINAL_REPAIR_REPORT.md. Baseline blob hashes still identify original source.",
  "workflows": {
    ".github/workflows/harmonybot-v73-v80-autonomous-evidence-pipeline.yml": {
      "baseline_blob_sha": "36004e4b597d2ca1e3403c178e7e2448cf862b3e",
      "contract": {
        "on": {
          "workflow_dispatch": null,
          "pull_request": {

              "HarmonyBot-V73/**",
              ".github/workflows/harmonybot-v73-v80-autonomous-evidence-pipeline.yml"
            ]
          }
        },
        "concurrency": {
          "group": "harmonybot-v73-v80-autonomous-evidence-g2",
          "cancel-in-progress": true
        },
        "permissions": {
          "contents": "write",
          "actions": "read"
        },
        "jobs": {
          "semantic_change_gate": {
            "runs-on": "ubuntu-24.04"
          },
          "build": {
            "needs": "semantic_change_gate",
            "if": "${{ needs.semantic_change_gate.outputs.full == 'true' && (github.event_name == 'workflow_dispatch' || github.head_ref == 'harmonybot/v73-opportunity-universe') }}",
            "runs-on": "ubuntu-24.04",
            "timeout-minutes": 30
          },
          "research_seed": {
            "needs": "build",
            "runs-on": "ubuntu-24.04",
            "strategy": {
              "fail-fast": false,
              "max-parallel": 5,
              "matrix": {
                "window": [
                  "Y2016",
                  "Y2017",
                  "Y2018",
                  "Y2019",
                  "Y2020"
                ]
              }
            },
            "timeout-minutes": 20
          },
          "burned_seed": {
            "needs": "build",
            "runs-on": "ubuntu-24.04",
            "strategy": {
              "fail-fast": false,
              "max-parallel": 3,
              "matrix": {
                "window": [
                  "Y2021",
                  "Y2022",
                  "Y2023"
                ]
              }
            },
            "timeout-minutes": 50
          },
          "v73_universe": {
            "needs": [
              "build",
              "research_seed",
              "burned_seed"
            ],
            "runs-on": "ubuntu-24.04",
            "strategy": {
              "fail-fast": false,
              "max-parallel": 8,
              "matrix": {
                "window": [
                  "Y2016",
                  "Y2017",
                  "Y2018",
                  "Y2019",
                  "Y2020",
                  "Y2021",
                  "Y2022",
                  "Y2023"
                ]
              }
            },
            "timeout-minutes": 50
          },
          "v73_gate": {
            "needs": "v73_universe",
            "runs-on": "ubuntu-24.04"
          },
          "promote_v73": {
            "needs": "v73_gate",
            "if": "${{ needs.v73_gate.outputs.pass == 'true' }}",
            "runs-on": "ubuntu-24.04"
          },
          "v74_tournament": {
            "needs": "v73_gate",
            "if": "${{ needs.v73_gate.outputs.pass == 'true' }}",
            "runs-on": "ubuntu-24.04",
            "timeout-minutes": 20
          },
          "promote_v74": {
            "needs": "v74_tournament",
            "if": "${{ needs.v74_tournament.outputs.pass == 'true' }}",
            "runs-on": "ubuntu-24.04"
          },
          "v75_policy": {
            "needs": "v74_tournament",
            "if": "${{ needs.v74_tournament.outputs.pass == 'true' }}",
            "runs-on": "ubuntu-24.04",
            "strategy": {
              "fail-fast": false,
              "matrix": {
                "window": [
                  "Y2021",
                  "Y2022",
                  "Y2023"
                ]
              }
            }
          },
          "v75_capital": {
            "needs": [
              "build",
              "burned_seed",
              "v75_policy"
            ],
            "runs-on": "ubuntu-24.04",
            "strategy": {
              "fail-fast": false,
              "max-parallel": 3,
              "matrix": {
                "window": [
                  "Y2021",
                  "Y2022",
                  "Y2023"
                ]
              }
            },
            "timeout-minutes": 50
          },
          "v75_gate": {
            "needs": "v75_capital",
            "runs-on": "ubuntu-24.04"
          },
          "promote_v75": {
            "needs": "v75_gate",
            "if": "${{ needs.v75_gate.outputs.pass == 'true' }}",

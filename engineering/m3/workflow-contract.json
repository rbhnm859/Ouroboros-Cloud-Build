      "baseline_blob_sha": "f9a54036142c687b4cb373e6b6b5038834a8bda9",
      "contract": {
        "on": {
          "workflow_dispatch": null,
          "push": {
            "branches": [
              "harmonybot/v73-opportunity-universe"
            ],
            "paths": [
              "HarmonyBot-V71/src/**",
              "HarmonyBot-V71/HarmonyBotV71.csproj",
              "HarmonyBot-V71/tools/run_window.sh",
              "HarmonyBot-V71/tools/run_backtest.sh",
              "HarmonyBot-V71/tools/resolve_window.sh",
              "HarmonyBot-V71/final/V71_BURNED_CALIBRATION_CUSTODY.json",
              "HarmonyBot-V73/V73_RESEARCH_CUSTODY.json"
            ]
          }
        },
        "concurrency": {
          "group": "harmonybot-v74-rapid-decision-v2-${{ github.head_ref || github.ref }}",
          "cancel-in-progress": true
        },
        "permissions": {
          "contents": "write",
          "actions": "write"
        },
        "jobs": {
          "rapid_change_gate": {
            "runs-on": "ubuntu-24.04"
          },
          "rapid_build": {
            "needs": "rapid_change_gate",
            "if": "${{ needs.rapid_change_gate.outputs.full == 'true' && (github.event_name == 'workflow_dispatch' || github.ref_name == 'harmonybot/v73-opportunity-universe') }}",
            "runs-on": "ubuntu-24.04",
            "timeout-minutes": 20
          },
          "rapid_universe": {
            "needs": "rapid_build",
            "runs-on": "ubuntu-24.04",
            "strategy": {
              "fail-fast": false,
              "max-parallel": 8,
              "matrix": {
                "window": [
                  "Y2016",
                  "Y2017",
                  "Y2018",
                  "Y2019",
                  "Y2020",
                  "Y2021",
                  "Y2022",
                  "Y2023"
                ]
              }
            },
            "timeout-minutes": 50
          },
          "rapid_decision": {
            "needs": "rapid_universe",
            "runs-on": "ubuntu-24.04",
            "timeout-minutes": 20
          },
          "full_verification": {
            "needs": "rapid_decision",
            "if": "${{ needs.rapid_decision.outputs.alpha_pass == 'true' }}",
            "runs-on": "ubuntu-24.04"
          },
          "pin_exact_replay_source": {
            "needs": [
              "rapid_change_gate",
              "rapid_decision"
            ],
            "if": "${{ always() && needs.rapid_decision.result == 'success' }}",
            "runs-on": "ubuntu-24.04"
          }
        }
      }
    },
